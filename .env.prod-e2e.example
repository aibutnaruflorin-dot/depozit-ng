# Copiază în .env.prod-e2e (gitignored) și completează valorile reale
# ÎNAINTE DE RULARE: dezactivează captcha în Supabase → Authentication → Attack Protection

ADMIN_USER=admin
ADMIN_PASS=parola_ta_admin_aici

# Supabase service_role key — Supabase Dashboard → Project Settings → API → service_role
# Necesar pentru setup vehicule/șoferi E2E (ocolește RLS SELECT pe app_vehicles/app_drivers)
SB_SERVICE_KEY=

# Parolele pentru userii de test (creați automat la prima rulare)
AGENT_PASS=E2eAgent#2026!
SOFER_PASS=E2eSofer#2026!
AJUTOR_PASS=E2eAjutor#2026!
